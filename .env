# ==============================================================================
# MD WRITER — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Instructions:
# 1. Go to your Supabase Project Dashboard: https://supabase.com/dashboard
# 2. Select your project -> Go to Project Settings -> API
# 3. Copy the "Project URL" and paste it into VITE_SUPABASE_URL below
# 4. Copy the "anon" / "public" API Key and paste it into VITE_SUPABASE_ANON_KEY below
#
# NOTE: If you leave these blank, MD Writer will automatically use
# Dexie.js (IndexedDB) for high-speed local offline storage.
# ==============================================================================

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
